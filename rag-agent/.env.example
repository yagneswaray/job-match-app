# Which LLM backend the ranking node should use: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Only the key matching LLM_PROVIDER needs to be set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama needs no API key — just a local server (ollama serve)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# How many candidates the vector store retrieval step pulls before the LLM re-ranks them
RETRIEVAL_TOP_K=10

# Vector store: Postgres + pgvector (run via `docker compose up -d` from the project root)
# Note the +psycopg — LangChain's PGVector uses SQLAlchemy, which needs the driver named explicitly.
PGVECTOR_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5433/jobmatch_vectors
